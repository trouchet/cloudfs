# name: test/sql/all_providers.test
# group: [sql]

require cloudfs

# Extension loads
query I
SELECT cloudfs_version() LIKE '%cloudfs%';
----
true

# All 4 schemes are registered
query I
SELECT cloudfs_providers() LIKE '%spfs%'
   AND cloudfs_providers() LIKE '%odfs%'
   AND cloudfs_providers() LIKE '%gdfs%'
   AND cloudfs_providers() LIKE '%dbxfs%';
----
true

# SharePoint token secret
statement ok
CREATE OR REPLACE SECRET sp (TYPE sharepoint, PROVIDER token, TOKEN 'tok');

# OneDrive token secret
statement ok
CREATE OR REPLACE SECRET od (TYPE onedrive, PROVIDER token, TOKEN 'tok');

# Google Drive token secret
statement ok
CREATE OR REPLACE SECRET gd (TYPE gdrive, PROVIDER token, TOKEN 'tok');

# Dropbox token secret
statement ok
CREATE OR REPLACE SECRET dbx (TYPE dropbox, PROVIDER token, TOKEN 'tok');

# All secrets visible
query I
SELECT count(*) FROM duckdb_secrets() WHERE type IN ('sharepoint','onedrive','gdrive','dropbox');
----
4

# Cache clear — single scheme
query I
SELECT cloudfs_clear_cache('spfs');
----
OK: cache cleared for 'spfs'

# Cache clear — all
query I
SELECT cloudfs_clear_cache();
----
OK: all caches cleared

# No crash on spfs:// without real credentials
statement error
SELECT * FROM read_parquet('spfs://x.sharepoint.com/sites/A/Docs/f.parquet') LIMIT 1;
----
Error

# No crash on odfs://
statement error
SELECT * FROM read_parquet('odfs://me/Documents/f.parquet') LIMIT 1;
----
Error

# No crash on gdfs://
statement error
SELECT * FROM read_parquet('gdfs://MyDrive/data/f.parquet') LIMIT 1;
----
Error

# No crash on dbxfs://
statement error
SELECT * FROM read_parquet('dbxfs://data/f.parquet') LIMIT 1;
----
Error

# Listing failures must not be reported as "no files found" (#19)
statement error
SELECT * FROM read_csv('vfs://127.0.0.1:1/data/*.csv');
----
no secret matches

statement error
SELECT * FROM read_csv('vfs://127.0.0.1:1/data/f.csv');
----
no secret matches

# Transport errors surface too (port 1 refuses connections)
statement ok
CREATE OR REPLACE SECRET v (TYPE vfs, PROVIDER token, TOKEN 'tok');

statement error
SELECT * FROM read_csv('vfs://127.0.0.1:1/data/*.csv');
----
cannot expand

statement ok
DROP SECRET v;

# ── Secret lifecycle (#17) ───────────────────────────────────────────────────

# Options are validated when the secret is created
statement error
CREATE SECRET bad (TYPE vfs, PROVIDER token, TOKEN '');
----
TOKEN required

statement error
CREATE SECRET bad (TYPE sharepoint, PROVIDER client_credentials, TENANT_ID 't');
----
CLIENT_ID required

# The first registered provider is the default
statement ok
CREATE SECRET dflt (TYPE sftp, KEY_PATH '/nonexistent/key');

query I
SELECT provider FROM duckdb_secrets() WHERE name = 'dflt';
----
keyfile

statement ok
DROP SECRET dflt;

# Sensitive options are redacted
statement ok
CREATE SECRET red (TYPE sharepoint, PROVIDER client_credentials,
                   TENANT_ID 't', CLIENT_ID 'c', CLIENT_SECRET 'supersecret');

query I
SELECT secret_string LIKE '%supersecret%' FROM duckdb_secrets() WHERE name = 'red';
----
false

statement ok
DROP SECRET red;

# SCOPE selects the secret: a path outside every scope has no credentials
statement ok
CREATE SECRET scoped (TYPE vfs, PROVIDER token, TOKEN 'tok', SCOPE 'vfs://127.0.0.1:1');

statement error
SELECT * FROM read_csv('vfs://127.0.0.1:2/data/f.csv');
----
no secret matches

# ... while a path inside the scope gets as far as the network
statement error
SELECT * FROM read_csv('vfs://127.0.0.1:1/data/f.csv');
----
connect

# DROP SECRET revokes access immediately
statement ok
DROP SECRET scoped;

statement error
SELECT * FROM read_csv('vfs://127.0.0.1:1/data/f.csv');
----
no secret matches

# PERSIST_TOKEN is a BOOLEAN option of the interactive oauth providers (#32)
statement ok
CREATE SECRET optout (TYPE onedrive, PROVIDER oauth, PERSIST_TOKEN false);

statement ok
CREATE OR REPLACE SECRET optout (TYPE gdrive, PROVIDER oauth,
                                 CLIENT_ID 'c', CLIENT_SECRET 's', PERSIST_TOKEN true);

statement error
CREATE OR REPLACE SECRET optout (TYPE dropbox, PROVIDER oauth,
                                 APP_KEY 'k', APP_SECRET 's', PERSIST_TOKEN 'maybe');
----
Could not convert

# ... and of no other provider
statement error
CREATE SECRET optout2 (TYPE onedrive, PROVIDER token, TOKEN 'x', PERSIST_TOKEN false);
----
persist_token

statement ok
DROP SECRET optout;

# gdrive oauth: REDIRECT_PORT fixes the port of the loopback listener (#40)
statement ok
CREATE SECRET gport (TYPE gdrive, PROVIDER oauth, CLIENT_ID 'c', REDIRECT_PORT 8085);

statement ok
CREATE OR REPLACE SECRET gport (TYPE gdrive, PROVIDER oauth, CLIENT_ID 'c', REDIRECT_PORT '0');

statement error
CREATE OR REPLACE SECRET gport (TYPE gdrive, PROVIDER oauth, CLIENT_ID 'c', REDIRECT_PORT 99999);
----
REDIRECT_PORT must be a port number

statement error
CREATE OR REPLACE SECRET gport (TYPE gdrive, PROVIDER oauth, CLIENT_ID 'c', REDIRECT_PORT 'web');
----
REDIRECT_PORT must be a port number

statement ok
DROP SECRET gport;

# Cleanup
statement ok
DROP SECRET sp; DROP SECRET od; DROP SECRET gd; DROP SECRET dbx;
