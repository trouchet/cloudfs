# name: test/sql/persistent_secret.test
# description: a persistent secret is honored after the database restarts (#17)
# group: [sql]

require cloudfs

load __TEST_DIR__/cloudfs_persistent_secret.db

statement ok
SET secret_directory='__TEST_DIR__/cloudfs_persistent_secrets'; -- pragma: allowlist secret

statement ok
CREATE OR REPLACE PERSISTENT SECRET persisted (TYPE vfs, PROVIDER token, TOKEN 'tok');

restart

statement ok
SET secret_directory='__TEST_DIR__/cloudfs_persistent_secrets'; -- pragma: allowlist secret

query II
SELECT name, persistent FROM duckdb_secrets() WHERE name = 'persisted';
----
persisted	true

# Port 1 refuses connections: reaching the network proves the secret was used.
statement error
SELECT * FROM read_csv('vfs://127.0.0.1:1/data/f.csv');
----
connect

statement ok
DROP PERSISTENT SECRET persisted;

statement error
SELECT * FROM read_csv('vfs://127.0.0.1:1/data/f.csv');
----
no secret matches
